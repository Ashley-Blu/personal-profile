# Copy this file to ".env" (same folder) and fill in the real values.
# NEVER commit ".env" to GitHub or share it.

PORT=3000

# SMTP account that SENDS the email (must be a real mailbox on your provider).
# Zoho: smtp.zoho.com / 587   |   Gmail: smtp.gmail.com / 587 (needs an App Password)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=admin@dattorney.co.za
SMTP_PASS=put-the-mailbox-password-or-app-password-here

# Where enquiries are delivered.
MAIL_TO=admin@dattorney.co.za
# Shown as the sender. Most providers require this to match SMTP_USER.
MAIL_FROM="Dolamo Attorneys Website" <admin@dattorney.co.za>

# Set to 1 only if the app sits behind a proxy/host that sets X-Forwarded-For
# (Render, Railway, Heroku, nginx...). Needed for correct per-visitor rate limiting.
TRUST_PROXY=0
